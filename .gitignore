## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.
##
## Get latest from https://github.com/github/gitignore/blob/main/VisualStudio.gitignore

# User-specific files
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates
*.env

# User-specific files (MonoDevelop/Xamarin Studio)
*.userprefs

# Mono auto generated files
mono_crash.*

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/

[Dd]ebug/x64/
[Dd]ebugPublic/x64/
[Rr]elease/x64/
[Rr]eleases/x64/
bin/x64/
obj/x64/

[Dd]ebug/x86/
[Dd]ebugPublic/x86/
[Rr]elease/x86/
[Rr]eleases/x86/
bin/x86/
obj/x86/

[Ww][Ii][Nn]32/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
[Aa][Rr][Mm]64[Ee][Cc]/
bld/
[Oo]bj/
[Oo]ut/
[Ll]og/
[Ll]ogs/

# Build results on 'Bin' directories
**/[Bb]in/*
# Uncomment if you have tasks that rely on *.refresh files to move binaries
#!**/[Bb]in/*.refresh

# Visual Studio cache
.vs/

Generated\ Files/

# MSTest
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*
*.trx

# NUnit
*.VisualState.xml
TestResult.xml
nunit-*.xml

# Benchmark
BenchmarkDotNet.Artifacts/

# .NET Core
project.lock.json
project.fragment.lock.json
artifacts/
.artifacts/

# NuGet / Node (у тебя уже есть, но усилил)
node_modules/

# =========================
# ADDED: macOS system files
# =========================
.DS_Store
.AppleDouble
.LSOverride
Icon?
._*
.Spotlight-V100
.Trashes
.fseventsd
.TemporaryItems
.VolumeIcon.icns
*.icloud

# =========================
# ADDED: frontend / JS / CSS / HTML
# =========================
dist/
build/
out/
coverage/
.cache/
.tmp/

# logs (extra)
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# archives
*.zip
*.rar
*.tar
*.gz
*.7z

# temp editor files
*.swp
*.swo
*~

# =========================
# ADDED: secrets safety
# =========================
.env.local
.env.*.local
*.key
*.pem
*.pfx

# =========================
# VS Code (fix extension coverage)
# =========================
.history/
